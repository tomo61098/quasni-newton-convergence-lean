module

public import QuasiNewtonConvergence.ProximalGradient

@[expose] public section

/-!
# Bregman gradient and proximal point methods

The kernel is supplied together with its gradient. The two algorithms use
their exact variational optimality conditions. This permits nonsmooth
finite-valued convex objectives without invoking a separate prox-existence
theorem.
-/

noncomputable section
namespace QuasiNewtonConvergence

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- The divergence generated by a differentiable kernel. -/
def bregmanD (h : E → ℝ) (dh : E → E) (x y : E) : ℝ :=
  h y - h x - inner ℝ (dh x) (y - x)

theorem bregmanD_nonneg (h : E → ℝ) (dh : E → E)
    (hconvex : ConvexFirstOrder h dh) (x y : E) :
    0 ≤ bregmanD h dh x y := by
  have hh := hconvex x y
  dsimp [bregmanD]
  linarith

@[simp] theorem bregmanD_self (h : E → ℝ) (dh : E → E)
    (x : E) : bregmanD h dh x x = 0 := by
  simp [bregmanD]

/-- The algebraic three-point identity for every differentiable kernel. -/
theorem bregman_three_point_identity (h : E → ℝ) (dh : E → E)
    (x z u : E) :
    inner ℝ (dh z - dh x) (u - z) =
      bregmanD h dh x u - bregmanD h dh z u -
        bregmanD h dh x z := by
  have hu : u - x = (u - z) + (z - x) := by abel
  dsimp [bregmanD]
  rw [hu]
  simp only [inner_sub_left, inner_add_right]
  ring

/-- Smoothness relative to a Bregman kernel. -/
def RelativeSmoothUpper (f h : E → ℝ) (gradient dh : E → E)
    (L : ℝ) : Prop :=
  ∀ x y, f y ≤ f x + inner ℝ (gradient x) (y - x) +
    L * bregmanD h dh x y

/-- Strong convexity measured by the kernel divergence. -/
def RelativeStrongFirstOrder (f h : E → ℝ)
    (gradient dh : E → E) (μ : ℝ) : Prop :=
  ∀ x y, f y ≥ f x + inner ℝ (gradient x) (y - x) +
    μ * bregmanD h dh x y

/-- Exact optimality for a composite Bregman gradient step. With zero
regularizer this is the ordinary mirror-descent step. -/
def BregmanGradientOptimality (g : E → ℝ)
    (gradient dh : E → E) (L : ℝ) (x z : E) : Prop :=
  ∀ u, g u - g z ≥ inner ℝ
    (-(gradient x) - L • (dh z - dh x)) (u - z)

/-- The Bregman-gradient three-point bound. -/
theorem bregmanGradient_three_point (f g h : E → ℝ)
    (gradient dh : E → E) (L : ℝ)
    (hsmooth : RelativeSmoothUpper f h gradient dh L)
    (hconvex : ConvexFirstOrder f gradient)
    (x z u : E)
    (hstep : BregmanGradientOptimality g gradient dh L x z) :
    composite f g z - composite f g u ≤
      L * (bregmanD h dh x u - bregmanD h dh z u) := by
  have hs := hsmooth x z
  have hc := hconvex x u
  have hp := hstep u
  have hi := bregman_three_point_identity h dh x z u
  have hgrad : inner ℝ (gradient x) (z - x) =
      inner ℝ (gradient x) (u - x) -
        inner ℝ (gradient x) (u - z) := by
    have hv : z - x = (u - x) - (u - z) := by abel
    rw [hv, inner_sub_right]
  rw [hgrad] at hs
  simp only [inner_sub_left, inner_neg_left, real_inner_smul_left] at hp
  rw [inner_sub_left] at hi
  have hiscaled := congrArg (fun t : ℝ => L * t) hi
  dsimp [composite]
  nlinarith [hiscaled]

/-- Relative strong convexity improves the Bregman potential inequality. -/
theorem bregmanGradient_strong_three_point (f g h : E → ℝ)
    (gradient dh : E → E) (L μ : ℝ)
    (hsmooth : RelativeSmoothUpper f h gradient dh L)
    (hstrong : RelativeStrongFirstOrder f h gradient dh μ)
    (x z u : E)
    (hstep : BregmanGradientOptimality g gradient dh L x z) :
    composite f g z - composite f g u ≤
      (L - μ) * bregmanD h dh x u -
        L * bregmanD h dh z u := by
  have hs := hsmooth x z
  have hc := hstrong x u
  have hp := hstep u
  have hi := bregman_three_point_identity h dh x z u
  have hgrad : inner ℝ (gradient x) (z - x) =
      inner ℝ (gradient x) (u - x) -
        inner ℝ (gradient x) (u - z) := by
    have hv : z - x = (u - x) - (u - z) := by abel
    rw [hv, inner_sub_right]
  rw [hgrad] at hs
  simp only [inner_sub_left, inner_neg_left, real_inner_smul_left] at hp
  rw [inner_sub_left] at hi
  have hiscaled := congrArg (fun t : ℝ => L * t) hi
  dsimp [composite]
  nlinarith [hiscaled]

/-- Exact Bregman proximal-point optimality for an objective F. -/
def BregmanProximalOptimality (F _h : E → ℝ) (dh : E → E)
    (L : ℝ) (x z : E) : Prop :=
  ∀ u, F u - F z ≥ inner ℝ
    (-(L • (dh z - dh x))) (u - z)

/-- The proximal-point inequality retains the extra nonnegative
divergence between the old and new iterates. -/
theorem bregmanProximal_three_point (F h : E → ℝ) (dh : E → E)
    (L : ℝ) (x z u : E)
    (hstep : BregmanProximalOptimality F h dh L x z) :
    F z - F u ≤ L * (bregmanD h dh x u -
      bregmanD h dh z u - bregmanD h dh x z) := by
  have hp := hstep u
  have hi := bregman_three_point_identity h dh x z u
  simp only [inner_neg_left, real_inner_smul_left] at hp
  have hiscaled := congrArg (fun t : ℝ => L * t) hi
  nlinarith [hiscaled]

/-- A common telescoping argument for Bregman methods. -/
theorem bregman_potential_rate (F h : E → ℝ) (dh : E → E)
    (L : ℝ) (hL : 0 ≤ L)
    (hkernel : ConvexFirstOrder h dh)
    (x : ℕ → E) (u : E)
    (hpot : ∀ k, F (x (k + 1)) - F u ≤
      L * (bregmanD h dh (x k) u -
        bregmanD h dh (x (k + 1)) u))
    (hmono : ∀ k, F (x (k + 1)) ≤ F (x k))
    (k : ℕ) :
    ((k + 1 : ℕ) : ℝ) * (F (x (k + 1)) - F u) ≤
      L * bregmanD h dh (x 0) u := by
  exact potential_last_iterate_bound (fun j => F (x j) - F u)
    (fun j => L * bregmanD h dh (x j) u)
    (fun j => sub_le_sub_right (hmono j) (F u))
    (fun j => by simpa only [mul_sub] using hpot j)
    (fun j => mul_nonneg hL (bregmanD_nonneg h dh hkernel (x j) u)) k

/-- Composite mirror descent (Bregman gradient) has an O(1/k) last-iterate
bound under convexity and relative smoothness. -/
theorem bregmanGradient_convex_rate
    (f g h : E → ℝ) (gradient dh : E → E) (L : ℝ)
    (hL : 0 ≤ L)
    (hsmooth : RelativeSmoothUpper f h gradient dh L)
    (hconvex : ConvexFirstOrder f gradient)
    (hkernel : ConvexFirstOrder h dh)
    (x : ℕ → E) (u : E)
    (hstep : ∀ k, BregmanGradientOptimality g gradient dh L
      (x k) (x (k + 1)))
    (k : ℕ) :
    ((k + 1 : ℕ) : ℝ) *
      (composite f g (x (k + 1)) - composite f g u) ≤
        L * bregmanD h dh (x 0) u := by
  have hpot (j : ℕ) :
      composite f g (x (j + 1)) - composite f g u ≤
        L * (bregmanD h dh (x j) u -
          bregmanD h dh (x (j + 1)) u) :=
    bregmanGradient_three_point f g h gradient dh L
      hsmooth hconvex (x j) (x (j + 1)) u (hstep j)
  have hmono (j : ℕ) :
      composite f g (x (j + 1)) ≤ composite f g (x j) := by
    have hp := bregmanGradient_three_point f g h gradient dh L
      hsmooth hconvex (x j) (x (j + 1)) (x j) (hstep j)
    have hd := bregmanD_nonneg h dh hkernel (x (j + 1)) (x j)
    simp only [bregmanD_self, zero_sub, mul_neg] at hp
    nlinarith [mul_nonneg hL hd]
  exact bregman_potential_rate (composite f g) h dh L hL hkernel
    x u hpot hmono k

/-- The exact Bregman proximal point method has the same O(1/k)
last-iterate bound for any convex objective. -/
theorem bregmanProximal_convex_rate
    (F h : E → ℝ) (dh : E → E) (L : ℝ)
    (hL : 0 ≤ L) (hkernel : ConvexFirstOrder h dh)
    (x : ℕ → E) (u : E)
    (hstep : ∀ k, BregmanProximalOptimality F h dh L
      (x k) (x (k + 1)))
    (k : ℕ) :
    ((k + 1 : ℕ) : ℝ) * (F (x (k + 1)) - F u) ≤
      L * bregmanD h dh (x 0) u := by
  have hpot (j : ℕ) : F (x (j + 1)) - F u ≤
      L * (bregmanD h dh (x j) u -
        bregmanD h dh (x (j + 1)) u) := by
    have hp := bregmanProximal_three_point F h dh L
      (x j) (x (j + 1)) u (hstep j)
    have hd := bregmanD_nonneg h dh hkernel (x j) (x (j + 1))
    nlinarith [mul_nonneg hL hd]
  have hmono (j : ℕ) : F (x (j + 1)) ≤ F (x j) := by
    have hp := bregmanProximal_three_point F h dh L
      (x j) (x (j + 1)) (x j) (hstep j)
    have hd1 := bregmanD_nonneg h dh hkernel (x j) (x (j + 1))
    have hd2 := bregmanD_nonneg h dh hkernel (x (j + 1)) (x j)
    simp only [bregmanD_self, zero_sub] at hp
    nlinarith [mul_nonneg hL hd1, mul_nonneg hL hd2]
  exact bregman_potential_rate F h dh L hL hkernel x u hpot hmono k

/-- Relative strong convexity contracts the Bregman distance to a
composite minimizer for mirror descent. -/
theorem bregmanGradient_strong_distance_rate
    (f g h : E → ℝ) (gradient dh : E → E)
    (L μ : ℝ) (hL : 0 < L) (_hμ : 0 < μ) (hμL : μ ≤ L)
    (hsmooth : RelativeSmoothUpper f h gradient dh L)
    (hstrong : RelativeStrongFirstOrder f h gradient dh μ)
    (x : ℕ → E) (u : E)
    (hmin : ∀ v, composite f g u ≤ composite f g v)
    (hstep : ∀ k, BregmanGradientOptimality g gradient dh L
      (x k) (x (k + 1)))
    (k : ℕ) :
    bregmanD h dh (x k) u ≤
      (1 - μ / L) ^ k * bregmanD h dh (x 0) u := by
  have hq : 0 ≤ 1 - μ / L :=
    sub_nonneg.mpr ((div_le_one hL).mpr hμL)
  have hc (j : ℕ) : bregmanD h dh (x (j + 1)) u ≤
      (1 - μ / L) * bregmanD h dh (x j) u := by
    have hp := bregmanGradient_strong_three_point f g h gradient dh
      L μ hsmooth hstrong (x j) (x (j + 1)) u (hstep j)
    have hm := hmin (x (j + 1))
    have hbasic : L * bregmanD h dh (x (j + 1)) u ≤
        (L - μ) * bregmanD h dh (x j) u := by linarith
    calc
      bregmanD h dh (x (j + 1)) u =
          (1 / L) * (L * bregmanD h dh (x (j + 1)) u) := by
            field_simp
      _ ≤ (1 / L) * ((L - μ) * bregmanD h dh (x j) u) :=
        mul_le_mul_of_nonneg_left hbasic (by positivity)
      _ = (1 - μ / L) * bregmanD h dh (x j) u := by
        field_simp
  induction k with
  | zero => simp
  | succ k ih =>
    calc
      bregmanD h dh (x (k + 1)) u ≤
          (1 - μ / L) * bregmanD h dh (x k) u := hc k
      _ ≤ (1 - μ / L) *
          ((1 - μ / L) ^ k * bregmanD h dh (x 0) u) :=
        mul_le_mul_of_nonneg_left ih hq
      _ = (1 - μ / L) ^ (k + 1) *
          bregmanD h dh (x 0) u := by rw [pow_succ]; ring

/-- A Bregman proximal step contracts the distance to a minimizer when
the objective gap dominates that same oriented divergence. -/
theorem bregmanProximal_strong_distance_rate
    (F h : E → ℝ) (dh : E → E)
    (L μ : ℝ) (hL : 0 ≤ L) (hμ : 0 < μ)
    (hkernel : ConvexFirstOrder h dh)
    (x : ℕ → E) (u : E)
    (hgrowth : ∀ v, μ * bregmanD h dh v u ≤ F v - F u)
    (hstep : ∀ k, BregmanProximalOptimality F h dh L
      (x k) (x (k + 1)))
    (k : ℕ) :
    bregmanD h dh (x k) u ≤
      (L / (L + μ)) ^ k * bregmanD h dh (x 0) u := by
  have hden : 0 < L + μ := by linarith
  have hq : 0 ≤ L / (L + μ) := div_nonneg hL hden.le
  have hc (j : ℕ) : bregmanD h dh (x (j + 1)) u ≤
      (L / (L + μ)) * bregmanD h dh (x j) u := by
    have hp := bregmanProximal_three_point F h dh L
      (x j) (x (j + 1)) u (hstep j)
    have hg := hgrowth (x (j + 1))
    have hd := bregmanD_nonneg h dh hkernel (x j) (x (j + 1))
    have hbasic : (L + μ) * bregmanD h dh (x (j + 1)) u ≤
        L * bregmanD h dh (x j) u := by
      nlinarith [mul_nonneg hL hd]
    calc
      bregmanD h dh (x (j + 1)) u =
          (1 / (L + μ)) * ((L + μ) *
            bregmanD h dh (x (j + 1)) u) := by field_simp
      _ ≤ (1 / (L + μ)) *
          (L * bregmanD h dh (x j) u) :=
        mul_le_mul_of_nonneg_left hbasic (by positivity)
      _ = (L / (L + μ)) * bregmanD h dh (x j) u := by ring
  induction k with
  | zero => simp
  | succ k ih =>
    calc
      bregmanD h dh (x (k + 1)) u ≤
          (L / (L + μ)) * bregmanD h dh (x k) u := hc k
      _ ≤ (L / (L + μ)) *
          ((L / (L + μ)) ^ k * bregmanD h dh (x 0) u) :=
        mul_le_mul_of_nonneg_left ih hq
      _ = (L / (L + μ)) ^ (k + 1) *
          bregmanD h dh (x 0) u := by rw [pow_succ]; ring

/-- Geometric objective gap for relatively strongly convex mirror descent. -/
theorem bregmanGradient_strong_objective_rate
    (f g h : E → ℝ) (gradient dh : E → E)
    (L μ : ℝ) (hL : 0 < L) (hμ : 0 < μ) (hμL : μ ≤ L)
    (hsmooth : RelativeSmoothUpper f h gradient dh L)
    (hstrong : RelativeStrongFirstOrder f h gradient dh μ)
    (hkernel : ConvexFirstOrder h dh)
    (x : ℕ → E) (u : E)
    (hmin : ∀ v, composite f g u ≤ composite f g v)
    (hstep : ∀ k, BregmanGradientOptimality g gradient dh L
      (x k) (x (k + 1)))
    (k : ℕ) :
    composite f g (x (k + 1)) - composite f g u ≤
      L * (1 - μ / L) ^ k * bregmanD h dh (x 0) u := by
  have hp := bregmanGradient_strong_three_point f g h gradient dh
    L μ hsmooth hstrong (x k) (x (k + 1)) u (hstep k)
  have hd := bregmanGradient_strong_distance_rate f g h gradient dh
    L μ hL hμ hμL hsmooth hstrong x u hmin hstep k
  have hnonneg := bregmanD_nonneg h dh hkernel (x (k + 1)) u
  have hnonnegX := bregmanD_nonneg h dh hkernel (x k) u
  have hscale := mul_le_mul_of_nonneg_left hd hL.le
  nlinarith [mul_nonneg hL.le hnonneg,
    mul_nonneg hμ.le hnonnegX]

/-- Geometric objective gap for a Bregman proximal point sequence with
relative growth at its minimizer. -/
theorem bregmanProximal_strong_objective_rate
    (F h : E → ℝ) (dh : E → E)
    (L μ : ℝ) (hL : 0 ≤ L) (hμ : 0 < μ)
    (hkernel : ConvexFirstOrder h dh)
    (x : ℕ → E) (u : E)
    (hgrowth : ∀ v, μ * bregmanD h dh v u ≤ F v - F u)
    (hstep : ∀ k, BregmanProximalOptimality F h dh L
      (x k) (x (k + 1)))
    (k : ℕ) :
    F (x (k + 1)) - F u ≤
      L * (L / (L + μ)) ^ k * bregmanD h dh (x 0) u := by
  have hp := bregmanProximal_three_point F h dh L
    (x k) (x (k + 1)) u (hstep k)
  have hd := bregmanProximal_strong_distance_rate F h dh L μ
    hL hμ hkernel x u hgrowth hstep k
  have hscale := mul_le_mul_of_nonneg_left hd hL
  have hnonneg1 := bregmanD_nonneg h dh hkernel
    (x (k + 1)) u
  have hnonneg2 := bregmanD_nonneg h dh hkernel
    (x k) (x (k + 1))
  nlinarith [mul_nonneg hL hnonneg1, mul_nonneg hL hnonneg2]

/-- Geometric Bregman-distance convergence implies convergence of the
points when the kernel divergence controls squared norm distance. -/
theorem bregman_geometric_iterates_tendsto
    (h : E → ℝ) (dh : E → E) (x : ℕ → E) (u : E)
    (q κ : ℝ) (hq0 : 0 ≤ q) (hq1 : q < 1) (hκ : 0 < κ)
    (hkernel : ConvexFirstOrder h dh)
    (hseparate : ∀ v, κ * ‖v - u‖ ^ 2 ≤ bregmanD h dh v u)
    (hrate : ∀ k, bregmanD h dh (x k) u ≤
      q ^ k * bregmanD h dh (x 0) u) :
    Filter.Tendsto x Filter.atTop (nhds u) := by
  have hgeom : Filter.Tendsto
      (fun k : ℕ => q ^ k * bregmanD h dh (x 0) u)
      Filter.atTop (nhds 0) := by
    simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one hq0 hq1).mul_const
      (bregmanD h dh (x 0) u)
  have hD : Filter.Tendsto (fun k => bregmanD h dh (x k) u)
      Filter.atTop (nhds 0) := by
    apply tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hgeom
    · intro k
      exact bregmanD_nonneg h dh hkernel (x k) u
    · exact hrate
  have hupper : Filter.Tendsto
      (fun k => bregmanD h dh (x k) u / κ)
      Filter.atTop (nhds 0) := by simpa using hD.div_const κ
  have hnormsq : Filter.Tendsto (fun k => ‖x k - u‖ ^ 2)
      Filter.atTop (nhds 0) := by
    apply tendsto_of_tendsto_of_tendsto_of_le_of_le
      tendsto_const_nhds hupper
    · intro k; exact sq_nonneg _
    · intro k
      exact (le_div_iff₀ hκ).2 (by simpa [mul_comm] using hseparate (x k))
  have hnorm : Filter.Tendsto (fun k => ‖x k - u‖)
      Filter.atTop (nhds 0) := by
    have hsqrt := (Real.continuous_sqrt.tendsto 0).comp hnormsq
    simpa only [Function.comp_def, Real.sqrt_sq_eq_abs,
      abs_of_nonneg (norm_nonneg _), Real.sqrt_zero] using hsqrt
  exact tendsto_iff_norm_sub_tendsto_zero.mpr hnorm

theorem bregmanGradient_strong_iterates_tendsto
    (f g h : E → ℝ) (gradient dh : E → E)
    (L μ κ : ℝ) (hL : 0 < L) (hμ : 0 < μ) (hμL : μ ≤ L)
    (hκ : 0 < κ)
    (hsmooth : RelativeSmoothUpper f h gradient dh L)
    (hstrong : RelativeStrongFirstOrder f h gradient dh μ)
    (hkernel : ConvexFirstOrder h dh)
    (x : ℕ → E) (u : E)
    (hmin : ∀ v, composite f g u ≤ composite f g v)
    (hseparate : ∀ v, κ * ‖v - u‖ ^ 2 ≤ bregmanD h dh v u)
    (hstep : ∀ k, BregmanGradientOptimality g gradient dh L
      (x k) (x (k + 1))) :
    Filter.Tendsto x Filter.atTop (nhds u) := by
  have hq0 : 0 ≤ 1 - μ / L :=
    sub_nonneg.mpr ((div_le_one hL).mpr hμL)
  have hq1 : 1 - μ / L < 1 := by
    have hdiv : 0 < μ / L := div_pos hμ hL
    linarith
  exact bregman_geometric_iterates_tendsto h dh x u
    (1 - μ / L) κ hq0 hq1 hκ hkernel hseparate
    (bregmanGradient_strong_distance_rate f g h gradient dh
      L μ hL hμ hμL hsmooth hstrong x u hmin hstep)

theorem bregmanProximal_strong_iterates_tendsto
    (F h : E → ℝ) (dh : E → E)
    (L μ κ : ℝ) (hL : 0 ≤ L) (hμ : 0 < μ) (hκ : 0 < κ)
    (hkernel : ConvexFirstOrder h dh)
    (x : ℕ → E) (u : E)
    (hgrowth : ∀ v, μ * bregmanD h dh v u ≤ F v - F u)
    (hseparate : ∀ v, κ * ‖v - u‖ ^ 2 ≤ bregmanD h dh v u)
    (hstep : ∀ k, BregmanProximalOptimality F h dh L
      (x k) (x (k + 1))) :
    Filter.Tendsto x Filter.atTop (nhds u) := by
  have hden : 0 < L + μ := by linarith
  have hq0 : 0 ≤ L / (L + μ) := div_nonneg hL hden.le
  have hq1 : L / (L + μ) < 1 :=
    (div_lt_one hden).2 (by linarith)
  exact bregman_geometric_iterates_tendsto h dh x u
    (L / (L + μ)) κ hq0 hq1 hκ hkernel hseparate
    (bregmanProximal_strong_distance_rate F h dh
      L μ hL hμ hkernel x u hgrowth hstep)

/-- A nonnegative objective gap with the Bregman O(1/k) estimate
converges to zero. -/
theorem bregman_rate_tendsto
    (F h : E → ℝ) (dh : E → E) (L : ℝ)
    (x : ℕ → E) (u : E)
    (hmin : ∀ v, F u ≤ F v)
    (hrate : ∀ k, ((k + 1 : ℕ) : ℝ) *
      (F (x (k + 1)) - F u) ≤ L * bregmanD h dh (x 0) u) :
    Filter.Tendsto (fun k => F (x k)) Filter.atTop (nhds (F u)) := by
  have hupper : Filter.Tendsto
      (fun k : ℕ => (L * bregmanD h dh (x 0) u) / ((k : ℝ) + 1))
      Filter.atTop (nhds 0) := by
    simpa [div_eq_mul_inv] using
      (tendsto_const_nhds (x := L * bregmanD h dh (x 0) u)).mul
        (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ))
  have hgap : Filter.Tendsto (fun k => F (x (k + 1)) - F u)
      Filter.atTop (nhds 0) := by
    apply tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hupper
    · intro k
      linarith [hmin (x (k + 1))]
    · intro k
      apply (le_div_iff₀ (by positivity : (0 : ℝ) < (k : ℝ) + 1)).2
      simpa only [Nat.cast_add, Nat.cast_one, mul_comm] using hrate k
  have hshift : Filter.Tendsto (fun k => F (x (k + 1)))
      Filter.atTop (nhds (F u)) := by
    simpa only [sub_add_cancel, zero_add] using hgap.add_const (F u)
  exact (Filter.tendsto_add_atTop_iff_nat 1).1 (by simpa using hshift)

theorem bregmanGradient_tendsto
    (f g h : E → ℝ) (gradient dh : E → E) (L : ℝ)
    (hL : 0 ≤ L)
    (hsmooth : RelativeSmoothUpper f h gradient dh L)
    (hconvex : ConvexFirstOrder f gradient)
    (hkernel : ConvexFirstOrder h dh)
    (x : ℕ → E) (u : E)
    (hmin : ∀ v, composite f g u ≤ composite f g v)
    (hstep : ∀ k, BregmanGradientOptimality g gradient dh L
      (x k) (x (k + 1))) :
    Filter.Tendsto (fun k => composite f g (x k))
      Filter.atTop (nhds (composite f g u)) :=
  bregman_rate_tendsto (composite f g) h dh L x u hmin
    (bregmanGradient_convex_rate f g h gradient dh L hL
      hsmooth hconvex hkernel x u hstep)

theorem bregmanProximal_tendsto
    (F h : E → ℝ) (dh : E → E) (L : ℝ)
    (hL : 0 ≤ L) (hkernel : ConvexFirstOrder h dh)
    (x : ℕ → E) (u : E)
    (hmin : ∀ v, F u ≤ F v)
    (hstep : ∀ k, BregmanProximalOptimality F h dh L
      (x k) (x (k + 1))) :
    Filter.Tendsto (fun k => F (x k))
      Filter.atTop (nhds (F u)) :=
  bregman_rate_tendsto F h dh L x u hmin
    (bregmanProximal_convex_rate F h dh L hL hkernel x u hstep)

end QuasiNewtonConvergence
